# Copier ce fichier en .env et remplir les valeurs

# Django
SECRET_KEY=changez-moi-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données (laisser vide pour SQLite en dev)
# DATABASE_URL=postgres://user:password@localhost:5432/goldenpousso

# CORS (domaines frontend autorisés)
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# URLs
FRONTEND_URL=https://goldenpousso.com
BACKEND_URL=https://api.goldenpousso.com

# PayDunya
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# Cloudinary — images (production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 — vidéos (production).
# Les cinq variables doivent être renseignées ensemble : s'il en manque une, les vidéos
# retombent sur Cloudinary. CLOUDFLARE_R2_PUBLIC_DOMAIN doit être un domaine
# personnalisé branché sur le bucket (l'adresse r2.dev est bridée, réservée aux tests).
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=goldenpousso-videos
CLOUDFLARE_R2_PUBLIC_DOMAIN=media.goldenpousso.com

# Email SMTP (production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=Golden Pousso <noreply@goldenpousso.com>
CONTACT_PHONE=+221 XX XXX XX XX
CONTACT_EMAIL=contact@goldenpousso.com
