# Copier ce fichier en .env et remplir les valeurs

# Django
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données (laisser vide pour SQLite en dev)
# En prod, renseigner l'URL PostgreSQL :
# DATABASE_URL=postgres://user:password@host:5432/goldenpousso_db

# Email (pour les notifications de commande)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=contact@goldenpousso.sn
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Golden Pousso <contact@goldenpousso.sn>
ADMIN_EMAIL=admin@goldenpousso.sn
